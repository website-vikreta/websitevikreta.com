# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id_here

# EmailJS (server-only; forms post to /api/contact, which sends the email)
# Values from https://dashboard.emailjs.com/. None of these are NEXT_PUBLIC_, so they never reach the browser.
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
# Account → API keys → Private Key. Then turn on Account → Security → "Use Private Key"
# so direct calls with the public IDs are refused (that is what stops bot spam).
EMAILJS_PRIVATE_KEY=your_private_key_here

# EmailJS template variables used by /api/contact:
# name, email, reply_to, mobile, service, service_type, budget, message, to_name

# ─── Cloudflare Turnstile (bot detection) ───────────────────────
# Widget mode: Managed. Appearance is set to `always` in code, so the
# verification widget is visible on every form.
# Get keys from: https://dash.cloudflare.com → Turnstile → Add site
# NEXT_PUBLIC_ prefix makes the site key available in the browser.
# The secret key is server-only — do NOT prefix with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ─── Sanity CMS ────────────────────────────────────────────────
# Get values from: https://sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only read token for draft previews and private datasets
# Create at: sanity.io/manage → API → Tokens → Add API token (Viewer role)
SANITY_API_READ_TOKEN=your_read_token_here

# ─── Calendly ──────────────────────────────────────────────────
# Booking link used by the "book a free audit" CTA banners.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/your-event
